# Frontend (safe to expose — protected by RLS)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# NEVER put service_role key, Discord client secret or bot token in any VITE_* variable.
# Discord Client ID/Secret are configured in Supabase Dashboard -> Authentication -> Providers -> Discord.
